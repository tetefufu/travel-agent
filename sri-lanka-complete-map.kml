      <Point><coordinates>80.4556,5.9444,0</coordinates></Point>
    </Placemark>

    <Placemark>
      <name>Secret Beach, Mirissa</name>
      <description>Hard to get to. Ask locals. 100% worth it. Less known. Option A Day 9.</description>
