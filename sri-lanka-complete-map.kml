      <Point><coordinates>80.4589,5.9353,0</coordinates></Point>
    </Placemark>

    <Placemark>
      <name>Parrot Rock + Coconut Hill, Mirissa</name>
      <description>Scramble for panoramic views. Instagram classic. Option A Day 9.</description>
