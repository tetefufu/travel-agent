      <styleUrl>#cafe</styleUrl>
      <Point><coordinates>80.4530,5.9480,0</coordinates></Point>
    </Placemark>

    <Placemark>
      <name>Hiriketiya Bay</name>
      <description>Small horseshoe cove. Most-saved drone shot. Stylish cafés, boutique crowd, good surf. Better than Mirissa for calm + aesthetics. Option A Day 10.</description>
      <styleUrl>#nature</styleUrl>
      <Point><coordinates>80.6056,5.9253,0</coordinates></Point>
    </Placemark>

    <Placemark>
      <name>Silent Beach, Dikwella</name>
      <description>Voted most beautiful in Sri Lanka. Untouched, total peace, no crowds. Option A Day 10.</description>
      <styleUrl>#nature</styleUrl>
      <Point><coordinates>80.7131,5.9781,0</coordinates></Point>
    </Placemark>

    <Placemark>
      <name>Cape Weligama</name>
      <description>Ultra-luxury. Best infinity pool in Sri Lanka. Peacocks, ocean views, world-class sunsets. Option A Nights 11–13.</description>
      <styleUrl>#hotel</styleUrl>
      <Point><coordinates>80.4461,5.9693,0</coordinates></Point>
    </Placemark>

